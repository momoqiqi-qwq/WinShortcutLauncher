{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yue launcher",
  "version": "0.1.117",
  "identifier": "com.yue.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yue launcher",
        "width": 1180,
        "height": 880,
        "visible": false,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "dragDropEnabled": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/launcher_new_256.png",
      "icons/launcher_new_512.png",
      "icons/launcher_new.ico"
    ]
  }
}
